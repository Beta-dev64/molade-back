NODE_ENV=development
PORT=4000
APP_NAME=Molade
APP_URL=http://localhost:8080
API_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/molade?schema=public
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

CORS_ORIGIN=http://localhost:8080

# --- Mail (preferred: Brevo transactional API) ---
# https://developers.brevo.com/docs/getting-started
BREVO_API_KEY=
# Must be a sender verified in Brevo (Senders & IPs)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Molade

# Fallback SMTP (only used when BREVO_API_KEY is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAIL_FROM="Molade <you@verified-sender.example>"
MAIL_LOGO_URL=http://localhost:8080/logo.png
